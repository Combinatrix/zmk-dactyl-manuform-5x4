if SHIELD_DACTYL_MANUFORM_5x4_LEFT

    # Name must be less than 16 characters long!
    config ZMK_KEYBOARD_NAME
        default "Dactyl 5x4"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif

if SHIELD_DACTYL_MANUFORM_5x4_RIGHT

    # Name must be less than 16 characters long!
    config ZMK_KEYBOARD_NAME
        default "Dactyl 5x4 R"

endif

if SHIELD_DACTYL_MANUFORM_5x4_LEFT || SHIELD_DACTYL_MANUFORM_5x4_RIGHT
    config ZMK_SPLIT
        default y
endif
